# Copy to .env beside docker-compose.yml and fill in.
# Same value as the Projects API's JWT_SECRET (Chatter's SECRET_KEY).
JWT_SECRET=
# Cloudflare tunnel token for language.kevsrobots.com -> http://localhost:8310
LANGUAGE_TUNNEL_TOKEN=
# Only if you override the default (www, apex, localhost:4000, local.kevsrobots.com:4000):
# CORS_ORIGINS=https://www.kevsrobots.com,https://kevsrobots.com,http://localhost:4000,http://local.kevsrobots.com:4000
